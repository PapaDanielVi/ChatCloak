{
  "manifest_version": 3,
  "name": "ChatCloak — Hide & Blur AI Chats for Screen Sharing",
  "short_name": "ChatCloak",
  "version": "1.1.0",
  "description": "Hide, blur, or redact sensitive user info, chat history, profile badges, and PII on AI chat web apps while screen sharing.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://chat.deepseek.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.cloud.microsoft/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://chat.qwen.ai/*",
    "https://chat.mistral.ai/*",
    "https://poe.com/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://duck.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChatCloak (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-chatcloak": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Toggle ChatCloak privacy protection ON or OFF"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://chat.qwen.ai/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://duck.ai/*"
      ],
      "css": [
        "styles/chatcloak.css"
      ],
      "js": [
        "content/adapters/base.js",
        "content/adapters/chatgpt.js",
        "content/adapters/gemini.js",
        "content/adapters/claude.js",
        "content/adapters/grok.js",
        "content/adapters/deepseek.js",
        "content/adapters/perplexity.js",
        "content/adapters/copilot.js",
        "content/adapters/meta.js",
        "content/adapters/qwen.js",
        "content/adapters/mistral.js",
        "content/adapters/poe.js",
        "content/adapters/kimi.js",
        "content/adapters/duckai.js",
        "content/adapters/registry.js",
        "content/patterns.js",
        "content/redactor.js",
        "content/picker.js",
        "content/main.js"
      ],
      "run_at": "document_start"
    }
  ]
}
